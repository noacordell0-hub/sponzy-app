# Copy this file to .env.local and fill in the values from
# Supabase dashboard > Project Settings > API. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Founding Creator spots shown on the landing page ([1,000] placeholder in CLAUDE.md)
NEXT_PUBLIC_FOUNDING_SPOTS=1000

# Public (publishable) key for signed-in features: Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Set to true to open account sign-up to everyone (otherwise waitlist members only)
BETA_OPEN=false
# Public contact email shown on the legal pages
NEXT_PUBLIC_CONTACT_EMAIL=
